[Unit]
Description=LogstashAgent simulate instance %i
After=network.target
Documentation=https://github.com/elastic/LogstashAgent

[Service]
Type=simple
# agent.env sets LOGSTASH_AGENT_STATE_DIR + LOGSTASH_AGENT_CONFIG for coexistence
# with packaged logstash-agent.service on the same host.
EnvironmentFile=-/opt/logstash-agent/simulate-%i/agent.env
# Runs controller + FastAPI for this simulate instance
ExecStart=/opt/logstash-agent/bin/logstash-agent --run --mode simulate --instance %i
Restart=always
RestartSec=10
WorkingDirectory=/opt/logstash-agent/simulate-%i
StandardOutput=journal
StandardError=journal
# The installer guarantees this account exists (ensure_logstash_user)
User=logstash
Group=logstash

[Install]
WantedBy=multi-user.target
